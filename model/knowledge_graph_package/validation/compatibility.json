{
  "schema_name": "dme-knowledge-package-compatibility",
  "schema_version": "3.0.0",
  "knowledge_domain_code": "STORAGE_FAULT_DIAGNOSIS",
  "description": "知识包兼容边界与旧结构映射（docs/19 §3.2）。记录本包对旧 schema_version 1.0.0 图谱结构的兼容读取关系。",
  "compatibility": {
    "adapter": ">=1.0.0 <2.0.0",
    "runtime": ">=1.0.0 <2.0.0",
    "legacy_schema_mapping": {
      "schema_version": "1.0.0",
      "node_type_map": {
        "OBJECT_TYPE": "RESOURCE_TYPE",
        "SYMPTOM": "SYMPTOM_CONCEPT",
        "FAULT_MODE": "FAULT_MODE",
        "MECHANISM": "FAULT_MECHANISM",
        "EVIDENCE_RULE": "DIAGNOSTIC_RULE",
        "CASE": "HISTORICAL_CASE"
      },
      "layer_map": {
        "OBJECT_TYPE": "L1",
        "SYMPTOM": "L3",
        "FAULT_MODE": "L2",
        "MECHANISM": "L3",
        "EVIDENCE_RULE": "L4",
        "CASE": "L4"
      },
      "relation_map": {
        "EXHIBITS": "MANIFESTS_AS",
        "SUSCEPTIBLE_TO": "APPLIES_TO_TYPE",
        "CAUSED_BY": "MANIFESTS_AS",
        "TRIGGERED_BY": "EXPLAINS_MODE",
        "LEADS_TO": "LEADS_TO",
        "EVIDENCED_BY": "SATISFIED_BY_RULE",
        "INSTANCE_OF_CASE": "EXEMPLIFIES",
        "REFERENCES": "MAPS_TO"
      },
      "note": "node_id 保持不变，仅 node_type/layer/relation 语义升级，前端知识平面与跨层映射无需改 id。"
    }
  }
}
