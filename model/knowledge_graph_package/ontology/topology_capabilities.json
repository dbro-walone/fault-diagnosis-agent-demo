    { "capability_code": "CAN_FORM_REDUNDANCY_WITH", "source_types": ["CONTROLLER", "FC_PORT", "SAN_FABRIC"], "target_types": ["CONTROLLER", "FC_PORT", "SAN_FABRIC"], "instance_relation": "REDUNDANT_WITH", "description": "冗余关系" },
    { "capability_code": "CAN_FAILOVER_TO", "source_types": ["CONTROLLER"], "target_types": ["CONTROLLER"], "instance_relation": "TopologyEvent.FAILOVER", "description": "故障切换事件能力" }
