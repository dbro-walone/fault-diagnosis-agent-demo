    { "capability_code": "CAN_PROVIDE_SERVICE_TO", "source_types": ["CONTROLLER", "BLOCK_SERVICE"], "target_types": ["*"], "instance_relation": "PROVIDES_SERVICE_TO", "description": "服务提供" },
    { "capability_code": "CAN_DEPEND_ON", "source_types": ["*"], "target_types": ["*"], "instance_relation": "DEPENDS_ON", "description": "依赖" },
    { "capability_code": "CAN_BE_BACKED_BY", "source_types": ["LUN"], "target_types": ["STORAGE_POOL"], "instance_relation": "BACKED_BY", "description": "逻辑资源由后端支撑" },
    { "capability_code": "CAN_SHARE", "source_types": ["*"], "target_types": ["*"], "instance_relation": "SHARES_WITH", "description": "稳定共享关系" },
