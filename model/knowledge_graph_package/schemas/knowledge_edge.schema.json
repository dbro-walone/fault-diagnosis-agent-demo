{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "dme://schemas/knowledge-edge.schema.json",
  "title": "KnowledgeEdge（docs/19 §4.5）",
  "type": "object",
  "required": ["edge_id", "relation_type", "source_ref", "target_ref"],
  "properties": {
    "edge_id": { "type": "string" },
    "relation_type": { "type": "string", "enum": ["HAS_RESOURCE_TYPE", "HAS_SCENARIO", "APPLIES_TO_TYPE", "HAS_FAULT_MODE", "EXPLAINS_MODE", "MANIFESTS_AS", "REQUIRES_EVIDENCE", "SATISFIED_BY_RULE", "SUPPORTED_BY_SKILL", "TEMPLATE_HAS_MEMBER", "EXEMPLIFIES", "OBSERVED_ON_TYPE", "MAPS_TO", "LEADS_TO"] },
    "source_ref": { "type": "string" },
    "target_ref": { "type": "string" },
    "role": { "type": ["string", "null"] },
    "strength": { "type": ["string", "null"], "enum": ["REQUIRED", "STRONG", "CONDITIONAL", "WEAK", null] },
    "conditions": { "type": "array" },
    "properties": { "type": "object" },
    "provenance": { "type": "object" }
  }
}
