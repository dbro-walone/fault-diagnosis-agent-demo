{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.local/dme-fault-agent/runtime-contract-2.0.schema.json",
  "title": "Diagnosis Runtime Contract V2.0",
  "type": "object",
  "required": ["schema_version", "session", "facts", "evidences", "candidates", "minimum_evidence_chain", "events"],
  "properties": {
    "schema_version": {"const": "2.0"},
    "session": {
      "type": "object",
      "required": ["session_id", "version", "last_sequence", "mode", "phase", "agent_focus"],
      "properties": {
        "session_id": {"type": "string", "minLength": 1},
        "case_id": {"type": ["string", "null"]},
        "version": {"type": "integer", "minimum": 0},
        "last_sequence": {"type": "integer", "minimum": 0},
        "mode": {"enum": ["LIVE", "PAUSED", "REPLAY"]},
        "phase": {"type": "string"},
        "terminal_status": {"type": ["string", "null"]},
        "agent_focus": {
          "type": "object",
          "required": ["object_refs"],
          "properties": {
            "source_type": {"type": ["string", "null"]},
            "source_id": {"type": ["string", "null"]},
            "object_refs": {"type": "array", "items": {"type": "string"}},
            "path_refs": {"type": "array", "items": {"type": "string"}}
          }
        }
      }
    },
    "facts": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["fact_id", "fact_type", "object_refs", "source", "payload"],
        "properties": {
          "fact_id": {"type": "string"},
          "fact_type": {"enum": ["ALARM", "LOG", "LOG_FINGERPRINT", "KPI_WINDOW", "TOPOLOGY_RELATION", "RESOURCE_STATE", "ABSENCE", "SIMILAR_CASE_REFERENCE"]},
          "object_refs": {"type": "array", "items": {"type": "string"}, "minItems": 1},
          "source": {
            "type": "object",
            "required": ["execution_id", "skill_id", "source_refs"],
            "properties": {
              "execution_id": {"type": "string"},
              "skill_id": {"type": "string"},
              "source_refs": {"type": "array", "items": {"type": "string"}, "minItems": 1}
            }
          },
          "payload": {"type": "object"},
          "created_sequence": {"type": "integer", "minimum": 1}
        }
      }
    },
    "evidences": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["evidence_id", "evidence_type", "fact_refs", "effects"],
        "properties": {
          "evidence_id": {"type": "string"},
          "evidence_type": {"type": "string"},
          "fact_refs": {"type": "array", "items": {"type": "string"}, "minItems": 1},
          "effects": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "required": ["candidate_id", "effect", "score_delta", "explanation"],
              "properties": {
                "candidate_id": {"type": "string"},
                "effect": {"enum": ["STRONG_SUPPORT", "SUPPORT", "WEAKEN", "CONFLICT", "NEUTRAL"]},
                "score_delta": {"type": "number"},
                "explanation": {"type": "string", "minLength": 1}
              }
            }
          },
          "created_sequence": {"type": "integer", "minimum": 1}
        }
      }
    },
    "candidates": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["candidate_id", "object_id", "fault_mode_code", "diagnosis_support_score", "status"],
        "properties": {
          "candidate_id": {"type": "string"},
          "object_id": {"type": "string"},
          "fault_mode_code": {"type": "string"},
          "diagnosis_support_score": {"type": "number", "minimum": 0, "maximum": 100},
          "status": {"enum": ["INITIAL", "ACTIVE", "LEADING", "WEAKENED", "CONFLICTING", "CONFIRMED", "NOT_CONFIRMED", "INSUFFICIENT_EVIDENCE"]}
        }
      }
    },
    "minimum_evidence_chain": {
      "type": "object",
      "required": ["candidate_id", "items"],
      "properties": {
        "candidate_id": {"type": "string"},
        "items": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["requirement_id", "required", "status", "evidence_refs"],
            "properties": {
              "requirement_id": {"type": "string"},
              "required": {"type": "boolean"},
              "status": {"enum": ["PENDING", "IN_PROGRESS", "SATISFIED", "CONFLICTING", "UNAVAILABLE"]},
              "evidence_refs": {"type": "array", "items": {"type": "string"}}
            }
          }
        }
      }
    },
    "events": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["event_id", "session_id", "sequence", "event_type", "payload"],
        "properties": {
          "event_id": {"type": "string"},
          "session_id": {"type": "string"},
          "sequence": {"type": "integer", "minimum": 1},
          "event_type": {"type": "string"},
          "payload": {"type": "object"}
        }
      }
    }
  }
}
